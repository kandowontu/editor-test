<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
  <!-- Exclude the native-windows WPF project source and XAML from the launcher build.
       The SDK's default globbing would otherwise pick up those files (they live in a subfolder)
       and try to compile them into this launcher project, which is not a WPF build and
       causes missing reference/duplicate entry-point errors. -->
  <ItemGroup>
    <Compile Remove="native-windows\**\*.cs" />
    <EmbeddedResource Remove="native-windows\**\*.*" />
    <None Remove="native-windows\**\*.*" />
    <Page Remove="native-windows\**\*.xaml" />
    <!-- Also exclude the small tools subprojects so their entry points don't collide with this launcher -->
    <Compile Remove="tools\**\*.cs" />
    <EmbeddedResource Remove="tools\**\*.*" />
    <None Remove="tools\**\*.*" />
    <Page Remove="tools\**\*.xaml" />
  </ItemGroup>
  <!-- This launcher intentionally does NOT reference the WPF project to avoid duplicate assembly entry points.
       It will run 'dotnet build native-windows\FamidashEditor.csproj' at runtime if needed and then launch the produced exe. -->
</Project>