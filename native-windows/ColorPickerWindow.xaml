<Window x:Class="FamidashEditor.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Background" Height="360" Width="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview and alpha -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,4" VerticalAlignment="Center">
            <Border x:Name="PreviewBorder" Width="96" Height="48" Background="Black" CornerRadius="4" Margin="0,0,12,0" />
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Alpha (strength):" />
                    <StackPanel x:Name="AlphaPanel" Orientation="Horizontal">
                        <Slider x:Name="ASlider" Minimum="0" Maximum="255" Width="260" />
                        <TextBlock x:Name="AVal" Width="40" TextAlignment="Center" />
                    </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Choose one or more palette colors (preview updates in realtime):" Margin="0,6,0,6" />

        <!-- Palette grid: boxed and tightly spaced to match the provided sample image -->
        <Border Grid.Row="2" Padding="6" Background="#202020" CornerRadius="4">
            <!-- Hide the visible vertical scrollbar but keep scrolling via mouse-wheel/ touch gesture -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="PalettePanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 14 columns x 4 rows layout matching the provided palette image -->
                            <UniformGrid Columns="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="4" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="4" />
        </StackPanel>
    </Grid>
</Window>