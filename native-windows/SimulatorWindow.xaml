<Window x:Class="FamidashEditor.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulator" Height="350" Width="288" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Background="#FF000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Debug controls at top -->
        <StackPanel x:Name="SettingsPanel" Grid.Row="0" Orientation="Vertical" Background="#FF222222" Margin="4,4,4,0">
            <!-- First row: Game Mode and Restart Button -->
            <Grid Margin="0,4,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Game Mode:" Foreground="White" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <ComboBox x:Name="GameModeComboBox" Width="120" SelectionChanged="GameModeComboBox_SelectionChanged" VerticalAlignment="Center" Margin="0,0,4,0" Focusable="False">
                        <ComboBoxItem Content="0 - Cube" IsSelected="True"/>
                        <ComboBoxItem Content="1 - Ship"/>
                        <ComboBoxItem Content="2 - Ball"/>
                        <ComboBoxItem Content="3 - UFO"/>
                        <ComboBoxItem Content="4 - Robot"/>
                        <ComboBoxItem Content="5 - Spider"/>
                        <ComboBoxItem Content="6 - Wave"/>
                        <ComboBoxItem Content="7 - Swing"/>
                        <ComboBoxItem Content="8 - Ninja"/>
                        <ComboBoxItem Content="9 - Pogo"/>
                        <ComboBoxItem Content="10 - Snake"/>
                        <ComboBoxItem Content="11 - Football"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="1" x:Name="RestartButton" Content="↻ Restart" Width="70" Height="24" 
                        Background="#FF444444" Foreground="White" BorderBrush="#FF666666" 
                        Click="RestartButton_Click" VerticalAlignment="Center" Margin="0,0,4,0"
                        ToolTip="Reset simulator to initial state"/>
            </Grid>
            <!-- Second row: Mini, Inverted, and Speed -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <CheckBox x:Name="MiniCheckBox" Content="Mini" Foreground="White" VerticalAlignment="Center" Margin="4,0,12,0" Checked="MiniCheckBox_Changed" Unchecked="MiniCheckBox_Changed" Focusable="False"/>
                <CheckBox x:Name="InvertedCheckBox" Content="Inverted" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" Checked="InvertedCheckBox_Changed" Unchecked="InvertedCheckBox_Changed" Focusable="False"/>
                <CheckBox x:Name="PathfinderCheckBox" Content="Pathfinder" Foreground="#FFAAFFAA" VerticalAlignment="Center" Margin="0,0,12,0" Checked="PathfinderCheckBox_Changed" Unchecked="PathfinderCheckBox_Changed" Focusable="False"/>
                <TextBlock Text="Speed:" Foreground="White" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <ComboBox x:Name="SpeedComboBox" Width="80" SelectionChanged="SpeedComboBox_SelectionChanged" VerticalAlignment="Center" Margin="0,0,4,0" Focusable="False">
                    <ComboBoxItem Content="0.5x" Tag="0"/>
                    <ComboBoxItem Content="1x" IsSelected="True" Tag="1"/>
                    <ComboBoxItem Content="2x" Tag="2"/>
                    <ComboBoxItem Content="3x" Tag="3"/>
                    <ComboBoxItem Content="4x" Tag="4"/>
                    <ComboBoxItem Content="0.1x" Tag="5"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        
        <!-- Canvas size corrected to match runtime NES_W * TILE / NES_H * TILE (256x240) -->
        <!-- Removed ClipToBounds to allow sprites with negative offsets to render without being cut off -->
        <Canvas x:Name="RenderCanvas" Grid.Row="1" Width="256" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True" MouseLeftButtonDown="RenderCanvas_MouseLeftButtonDown" />

        <!-- Pause overlay shown while simulation is paused -->
        <Grid x:Name="PauseOverlay" Grid.Row="1" Width="256" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="True" MouseLeftButtonUp="PauseOverlay_MouseLeftButtonUp" Cursor="Hand">
            <Rectangle Fill="#80000000" Width="256" Height="240" />
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="PauseOverlayCircle" Width="120" Height="120" Fill="#AA000000" />
                <StackPanel x:Name="PauseOverlayIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Height="80" Margin="0,0,0,0">
                    <Rectangle Width="16" Height="80" Fill="White" RadiusX="2" RadiusY="2" Margin="6,0" />
                    <Rectangle Width="16" Height="80" Fill="White" RadiusX="2" RadiusY="2" Margin="6,0" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="PauseOverlayText" Text="" Foreground="#AAFFAAFF" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" />
        </Grid>

        <!-- Level complete overlay shown when end-level trigger (0x0F) is reached -->
        <Grid x:Name="LevelCompleteOverlay" Grid.Row="1" Width="256" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle Fill="#AA000000" Width="256" Height="240" />
            <TextBlock Text="LEVEL COMPLETE" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Consolas"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="2" Color="Black" Opacity="0.8" BlurRadius="4" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Grid>
</Window>