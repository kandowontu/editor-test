<Window x:Class="FamidashEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FamidashEditor" Height="900" Width="1200"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- lighter default grey -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#3B3B3B" />
        
        
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left palettes -->
        <Grid x:Name="TileboardPanel" Grid.Column="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
                <Border x:Name="TilesLabelBorder" BorderBrush="Transparent" BorderThickness="3" Padding="6,3" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="TilesLabel_Click">
                    <TextBlock x:Name="TilesLabel" Text="TILES" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="  " />
                <!-- Eye toggle for Tiles layer -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,2,0">
                    <ToggleButton x:Name="TileEyeButton" Width="20" Height="18" FontSize="12" ToolTip="Toggle Tiles Layer Visibility" Checked="TileEyeButton_Checked" Unchecked="TileEyeButton_Unchecked">👁</ToggleButton>
                    <TextBlock Text="Size:" VerticalAlignment="Center" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <Slider x:Name="TileSizeSlider" Minimum="8" Maximum="48" Value="16" Width="80" VerticalAlignment="Center"
                    TickFrequency="4" SmallChange="4" LargeChange="8" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="TileIdIndicator" Text="" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" FontFamily="Consolas" Foreground="#AAAAAA" />
                <Image x:Name="TileSelectedPreviewImage" Width="40" Height="40" Margin="8,0,0,0" VerticalAlignment="Center" Stretch="Uniform" />
            </StackPanel>

            <!-- Use ListBox's internal ScrollViewer to avoid double scrollbars -->
            <ListBox x:Name="TilesPanel" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="16" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,8,4,4" VerticalAlignment="Center">
                <Border x:Name="SpritesLabelBorder" BorderBrush="Transparent" BorderThickness="3" Padding="6,3" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="SpritesLabel_Click">
                    <TextBlock x:Name="SpritesLabel" Text="SPRITES" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="  " />
                <!-- Eye toggle for Sprites layer -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,2,0">
                    <ToggleButton x:Name="SpriteEyeButton" Width="20" Height="18" FontSize="12" ToolTip="Toggle Sprites Layer Visibility" Checked="SpriteEyeButton_Checked" Unchecked="SpriteEyeButton_Unchecked">👁</ToggleButton>
                    <TextBlock Text="Size:" VerticalAlignment="Center" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <Slider x:Name="SpriteSizeSlider" Minimum="8" Maximum="48" Value="16" Width="80" VerticalAlignment="Center"
                    TickFrequency="4" SmallChange="4" LargeChange="8" IsSnapToTickEnabled="True" />
                <TextBlock x:Name="SpriteIdIndicator" Text="" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" FontFamily="Consolas" Foreground="#AAAAAA" />
                <Image x:Name="SpriteSelectedPreviewImage" Width="40" Height="40" Margin="8,0,0,0" VerticalAlignment="Center" Stretch="Uniform" />
            </StackPanel>

            <ListBox x:Name="SpritesPanel" Grid.Row="3" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="16" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#33000000" ShowsPreview="False"/>

        <!-- Main area -->
        <DockPanel x:Name="MainEditorPanel" Grid.Column="2">
            <!-- Menu Bar -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem x:Name="MenuFileNew" Header="_New TMX" InputGestureText="Ctrl+N" />
                    <MenuItem x:Name="MenuFileSave" Header="_Save TMX" InputGestureText="Ctrl+S" />
                    <MenuItem x:Name="MenuFileSaveAs" Header="Save TMX _As..." InputGestureText="Ctrl+Alt+S" />
                    <MenuItem x:Name="MenuFileLoad" Header="_Open TMX" InputGestureText="Ctrl+O" />
                    <MenuItem x:Name="MenuFileRecent" Header="Open _Recent">
                        <!-- Recent files will be populated dynamically -->
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuFileClose" Header="Close _Tab" InputGestureText="Ctrl+W" />
                    <Separator />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem x:Name="MenuToolPlace" Header="_Brush" IsCheckable="True" IsChecked="True" InputGestureText="B" />
                    <MenuItem x:Name="MenuToolMove" Header="_Move" IsCheckable="True" InputGestureText="M" />
                    <MenuItem x:Name="MenuToolErase" Header="_Erase" IsCheckable="True" InputGestureText="E" />
                    <MenuItem x:Name="MenuToolFill" Header="_Fill" IsCheckable="True" InputGestureText="F" />
                    <MenuItem x:Name="MenuToolSelect" Header="_Select" IsCheckable="True" InputGestureText="S" />
                    <MenuItem x:Name="MenuToolWand" Header="_Magic Wand" IsCheckable="True" InputGestureText="W" />
                    <MenuItem x:Name="MenuToolStructure" Header="_Structure" IsCheckable="True" InputGestureText="T" />
                    <Separator />
                    <MenuItem x:Name="MenuEditCut" Header="Cu_t" InputGestureText="Ctrl+X" />
                    <MenuItem x:Name="MenuEditCopy" Header="_Copy" InputGestureText="Ctrl+C" />
                    <MenuItem x:Name="MenuEditPaste" Header="_Paste" InputGestureText="Ctrl+V" />
                    <Separator />
                    <MenuItem x:Name="MenuToolUndo" Header="_Undo" InputGestureText="Ctrl+Z" />
                    <MenuItem x:Name="MenuToolRedo" Header="_Redo" InputGestureText="Ctrl+Y" />
                    <Separator />
                    <MenuItem x:Name="MenuOpenSimulator" Header="Open _Simulator" InputGestureText="F5" />
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Header="Editor Options">
                        <MenuItem x:Name="MenuOptionLegacyTriggers" Header="Legacy Trigger Load/Save" IsCheckable="True" IsChecked="False" />
                        <MenuItem x:Name="MenuOptionSuppressCollisionMessages" Header="Suppress Collision Messages" IsCheckable="True" IsChecked="True" />
                        <MenuItem x:Name="MenuOptionSwapMouseWheel" Header="Swap Mouse Wheel Scroll" IsCheckable="True" IsChecked="False" />
                        <MenuItem x:Name="MenuOptionSwapPinch" Header="Swap Wheel/Pinch Zoom" IsCheckable="True" IsChecked="True" />
                        <MenuItem x:Name="MenuColorEditorBackground" Header="Editor Background Color..." />
                        <Separator />
                        <MenuItem Header="Tileboard Position">
                            <MenuItem x:Name="MenuTileboardLeft" Header="Left" IsCheckable="True" IsChecked="True" />
                            <MenuItem x:Name="MenuTileboardRight" Header="Right" IsCheckable="True" IsChecked="False" />
                            <MenuItem x:Name="MenuTileboardTop" Header="Top" IsCheckable="True" IsChecked="False" />
                            <MenuItem x:Name="MenuTileboardBottom" Header="Bottom" IsCheckable="True" IsChecked="False" />
                            <Separator />
                            <MenuItem x:Name="MenuTileboardHidden" Header="Hidden" IsCheckable="True" IsChecked="False" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="MenuColorPlayerTint" Header="Player Color..." />
                    <MenuItem Header="FamiStudio">
                        <MenuItem x:Name="MenuConfigureFamiStudio" Header="Configure FamiStudio..." />
                            <MenuItem x:Name="MenuScanFamiStudioTracks" Header="Load User FMS..." />
                    </MenuItem>
                    <MenuItem Header="Level Options">
                        <MenuItem x:Name="MenuColorBackgroundTint" Header="Background Tint..." />
                        <MenuItem x:Name="MenuColorGroundTint" Header="Ground Tint..." />
                        <MenuItem x:Name="MenuColorTileTint" Header="Tile Tint..." />
                        <Separator />
                        <MenuItem x:Name="MenuOptionShowAccurateTileset" Header="Show accurate tileset" IsCheckable="True" IsChecked="False" Checked="MenuOptionShowAccurateTileset_Checked" Unchecked="MenuOptionShowAccurateTileset_Unchecked" />
                        <Separator />
                        <MenuItem x:Name="MenuOptionNoParallax" Header="No Parallax BG" IsCheckable="True" IsChecked="False" />
                        <MenuItem x:Name="MenuOptionLockSprites" Header="Lock sprites to usable set" IsCheckable="True" IsChecked="False" />
                    </MenuItem>
                    <MenuItem Header="Preview Mode Options">
                        <MenuItem x:Name="MenuOptionHideColorTriggers" Header="Hide Color Triggers" IsCheckable="True" IsChecked="False" />
                        <MenuItem x:Name="MenuOptionHideInvisibleSprites" Header="Hide Invisible Sprites" IsCheckable="True" IsChecked="False" />
                    </MenuItem>
                    <MenuItem Header="Simulator Options">
                        <MenuItem Header="Simulator Size">
                            <MenuItem x:Name="MenuSimulatorSize1x" Header="1x" IsCheckable="True" />
                            <MenuItem x:Name="MenuSimulatorSize2x" Header="2x" IsCheckable="True" />
                            <MenuItem x:Name="MenuSimulatorSize3x" Header="3x" IsCheckable="True" />
                            <MenuItem x:Name="MenuSimulatorSize4x" Header="4x" IsCheckable="True" />
                        </MenuItem>
                        <MenuItem x:Name="MenuOptionShowSpriteHitboxes" Header="Show Sprite Hitboxes" IsCheckable="True" IsChecked="False" InputGestureText="F2" Checked="MenuOptionShowSpriteHitboxes_Checked" Unchecked="MenuOptionShowSpriteHitboxes_Unchecked" />
                        <MenuItem x:Name="MenuOptionHideTriggerSprites" Header="Hide Trigger Sprites" IsCheckable="True" IsChecked="True" Checked="MenuOptionHideTriggerSprites_Checked" Unchecked="MenuOptionHideTriggerSprites_Unchecked" />
                        <MenuItem x:Name="MenuOptionOpenSimulatorPaused" Header="Open Simulator Paused" IsCheckable="True" IsChecked="False" />
                    </MenuItem>
                </MenuItem>
            </Menu>
            
            <!-- Tab Control for multiple files -->
            <TabControl x:Name="FileTabControl" DockPanel.Dock="Top" Height="30" SelectionChanged="FileTabControl_SelectionChanged">
                <!-- Tabs will be added dynamically -->
            </TabControl>
            
            <!-- Toolbar -->
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <ToggleButton x:Name="PlaceTool" IsChecked="True" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Brush" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MoveTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Move" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="EraseTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌫" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Erase" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FillTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪣" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Fill" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="SelectTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Select" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MagicWandTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Wand" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="StructureTool" Margin="2" Click="StructureTool_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⤢" FontSize="12" Margin="2,0" />
                            <Image x:Name="StructureToolIcon" Width="16" Height="16" Margin="2,0" Visibility="Collapsed" />
                            <TextBlock Text="Structure" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Popup for selecting Structure sets A/B/C -->
                    <Popup x:Name="StructurePopup" PlacementTarget="{Binding ElementName=StructureTool}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#EE222222" Padding="6" CornerRadius="4">
                            <StackPanel Orientation="Vertical">
                                <Button x:Name="StructureSetAButton" Click="StructureSetAButton_Click" Margin="2" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="StructureSetAIcon" Width="20" Height="20" Margin="2" />
                                        <TextBlock Text="Set A" VerticalAlignment="Center" Margin="6,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StructureSetBButton" Click="StructureSetBButton_Click" Margin="2" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="StructureSetBIcon" Width="20" Height="20" Margin="2" />
                                        <TextBlock Text="Set B" VerticalAlignment="Center" Margin="6,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StructureSetCButton" Click="StructureSetCButton_Click" Margin="2" Padding="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="StructureSetCIcon" Width="20" Height="20" Margin="2" />
                                        <TextBlock Text="Set C" VerticalAlignment="Center" Margin="6,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- Undo/Redo moved next to brush controls -->
                    <Separator Margin="8,0" />
                    <CheckBox x:Name="PreviewModeCheckbox" Content="Preview Mode" VerticalAlignment="Center" Margin="4,0" ToolTip="Enable animated previews (saws, etc.)" />
                    <ComboBox x:Name="FamiTrackCombo" Width="220" Margin="8,0" VerticalAlignment="Center" IsEditable="False"/>
                    <Button x:Name="PlayFamiButton" Content="▶" Margin="4,0" Width="36" ToolTip="Play" FontSize="14" />
                    <Button x:Name="StopFamiButton" Content="⏹" Margin="2,0" Width="36" ToolTip="Stop" FontSize="14" />
                </ToolBar>
            </ToolBarTray>

            <!-- Shape drawing toolbar -->
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <ToggleButton x:Name="DrawTileButton" Margin="2" IsChecked="True">Tile</ToggleButton>
                    <ToggleButton x:Name="DrawLineButton" Margin="2">Line</ToggleButton>
                    <ToggleButton x:Name="DrawSquareButton" Margin="2">Square</ToggleButton>
                    <ToggleButton x:Name="DrawCircleButton" Margin="2">Circle</ToggleButton>
                    <ToggleButton x:Name="DrawTriangleButton" Margin="2">Triangle</ToggleButton>
                    <ToggleButton x:Name="DrawPolygonButton" Margin="2">Polygon</ToggleButton>
                    <CheckBox x:Name="HollowCheckBox" Content="Hollow" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Text="Brush:" VerticalAlignment="Center" Margin="8,0,2,0" />
                    <Slider x:Name="BrushThicknessSlider" Minimum="1" Maximum="7" Value="1" Width="120" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="1"/>
                    <Button x:Name="UndoButton" Margin="8,0,0,0" ToolTip="Undo (Ctrl+Z)">Undo</Button>
                    <Button x:Name="RedoButton" Margin="4,0,0,0" ToolTip="Redo (Ctrl+Y)">Redo</Button>
                    <Separator Margin="8,0" />
                    <Button x:Name="CutButton" Margin="4,0" ToolTip="Cut (Ctrl+X)">Cut</Button>
                    <Button x:Name="CopyButton" Margin="4,0" ToolTip="Copy (Ctrl+C)">Copy</Button>
                    <Button x:Name="PasteButton" Margin="4,0" ToolTip="Paste (Ctrl+V)">Paste</Button>
                </ToolBar>
            </ToolBarTray>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
            <Button x:Name="SaveButton" Content="Save" Margin="2" ToolTip="Save TMX (Ctrl+S)" />
            <Button x:Name="LoadButton" Content="Open" Margin="2" ToolTip="Open TMX (Ctrl+O)" />
            <Button x:Name="SetOptionsButton" Content="Set Options" Margin="8,2" ToolTip="Level options (deco set)" />
            <TextBlock Text="Width (X):" VerticalAlignment="Center" Margin="6,0,2,0" />
            <TextBox x:Name="WidthBox" Width="60" Margin="2" />
            <TextBlock Text="Height (Y):" VerticalAlignment="Center" Margin="8,0,2,0" />
            <TextBox x:Name="HeightBox" Width="60" Margin="2" />
            <Button x:Name="ResizeButton" Content="Resize" Margin="2" />
            <TextBlock x:Name="StatusText" Margin="8,2" VerticalAlignment="Center" Visibility="Visible">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="StatusText_Copy_Click" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
            </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
            <TextBlock Text="Grid darkness:" VerticalAlignment="Center" Margin="4,0"/>
            <Slider x:Name="GridDarknessSlider" Minimum="0" Maximum="1" Value="0.18" Width="200" Focusable="False" />
            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="4" Value="1" Width="200" Focusable="False" />
            <TextBlock x:Name="ZoomLevelLabel" Text="1.00x" VerticalAlignment="Center" Margin="6,0,0,0" Width="56" />

        </StackPanel>

        <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                      IsManipulationEnabled="True">
            <Grid>
                <!-- Background base, Parallax, Ground, Tiles layer, Sprites layer, Grid overlay -->
                <Image x:Name="BackgroundImage" Panel.ZIndex="0" />
                <Image x:Name="ParallaxImage" Panel.ZIndex="1" />
                <Image x:Name="GroundImage" Panel.ZIndex="2" />
                <Image x:Name="TilesImage" Panel.ZIndex="3" />
                <Image x:Name="PortalsImage" Panel.ZIndex="4" />
                <Image x:Name="SpritesImage" Panel.ZIndex="5" />
                <Image x:Name="GridImage" Panel.ZIndex="6" />
                <Canvas x:Name="CanvasHost" Background="Transparent" Panel.ZIndex="7">
                    <!-- Hover rectangle: shown while mouse is over a tile -->
                    <Rectangle x:Name="HoverRect" Fill="#28FFFF00" Stroke="Yellow" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    <Border x:Name="HoverBorder" Background="#28FFFF00" BorderBrush="Yellow" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        <!-- Selection overlay canvas: contains individual rectangle overlays for each selected tile -->
                        <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" />
                            <Canvas x:Name="IncompatibleOverlay" IsHitTestVisible="False" />
                        <!-- Ghost image shown while dragging a selection -->
                        <Image x:Name="GhostImage" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.75" />
                        <!-- Offset sprite tooltip overlay -->
                        <Rectangle x:Name="OffsetGhostTile" Fill="Transparent" Stroke="#88FFFFFF" StrokeThickness="1" StrokeDashArray="2,2" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Canvas x:Name="OffsetTooltipContainer" Visibility="Collapsed" IsHitTestVisible="False">
                            <!-- Multiple offset tooltips will be added here dynamically -->
                        </Canvas>
                        <Canvas x:Name="OffsetGhostContainer" Visibility="Collapsed" IsHitTestVisible="False">
                            <!-- Multiple ghost tiles will be added here dynamically -->
                        </Canvas>
                </Canvas>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
