<Window x:Class="FamidashEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FamidashEditor" Height="900" Width="1200"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- lighter default grey -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#3B3B3B" />
        
        
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left palettes -->
        <Grid Grid.Column="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
                <Border x:Name="TilesLabelBorder" BorderBrush="Transparent" BorderThickness="3" Padding="6,3" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="TilesLabel_Click">
                    <TextBlock x:Name="TilesLabel" Text="TILES" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="  " />
                <TextBlock Text="Size:" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="11" />
                <Slider x:Name="TileSizeSlider" Minimum="8" Maximum="48" Value="16" Width="80" VerticalAlignment="Center" />
                <TextBlock x:Name="TileIdIndicator" Text="" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" FontFamily="Consolas" Foreground="#AAAAAA" />
            </StackPanel>

            <!-- Use ListBox's internal ScrollViewer to avoid double scrollbars -->
            <ListBox x:Name="TilesPanel" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="16" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="6,8,4,4" VerticalAlignment="Center">
                <Border x:Name="SpritesLabelBorder" BorderBrush="Transparent" BorderThickness="3" Padding="6,3" CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="SpritesLabel_Click">
                    <TextBlock x:Name="SpritesLabel" Text="SPRITES" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="  " />
                <TextBlock Text="Size:" VerticalAlignment="Center" Margin="6,0,2,0" FontSize="11" />
                <Slider x:Name="SpriteSizeSlider" Minimum="8" Maximum="48" Value="16" Width="80" VerticalAlignment="Center" />
                <TextBlock x:Name="SpriteIdIndicator" Text="" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" FontFamily="Consolas" Foreground="#AAAAAA" />
            </StackPanel>

            <ListBox x:Name="SpritesPanel" Grid.Row="3" BorderThickness="0" Background="Transparent" SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="16" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#33000000" ShowsPreview="False"/>

        <!-- Main area -->
        <DockPanel Grid.Column="2">
            <!-- Menu Bar -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem x:Name="MenuFileNew" Header="_New" />
                    <MenuItem x:Name="MenuFileSave" Header="_Save" />
                    <MenuItem x:Name="MenuFileLoad" Header="_Load" />
                    <Separator />
                    <MenuItem x:Name="MenuFileResize" Header="_Resize Map..." />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem x:Name="MenuToolPlace" Header="_Place" IsCheckable="True" IsChecked="True" />
                    <MenuItem x:Name="MenuToolMove" Header="_Move" IsCheckable="True" />
                    <MenuItem x:Name="MenuToolErase" Header="_Erase" IsCheckable="True" />
                    <MenuItem x:Name="MenuToolFill" Header="_Fill" IsCheckable="True" />
                    <MenuItem x:Name="MenuToolSelect" Header="_Select" IsCheckable="True" />
                    <MenuItem x:Name="MenuToolWand" Header="_Magic Wand" IsCheckable="True" />
                    <Separator />
                    <MenuItem x:Name="MenuToolUndo" Header="_Undo" InputGestureText="Ctrl+Z" />
                    <MenuItem x:Name="MenuToolRedo" Header="_Redo" InputGestureText="Ctrl+Y" />
                </MenuItem>
                <MenuItem Header="_Colors">
                    <MenuItem x:Name="MenuColorEditorBackground" Header="_Editor Background Color..." />
                    <Separator />
                    <MenuItem x:Name="MenuColorBackgroundTint" Header="_Background Tint..." />
                    <MenuItem x:Name="MenuColorGroundTint" Header="_Ground Tint..." />
                    <MenuItem x:Name="MenuColorTileTint" Header="_Tile Tint..." />
                    <MenuItem x:Name="MenuColorPlayerTint" Header="_Player Color..." />
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem x:Name="MenuOptionLegacyTriggers" Header="Legacy Trigger Load/Save" IsCheckable="True" IsChecked="False" />
                </MenuItem>
            </Menu>
            
            <!-- Toolbar -->
            <ToolBarTray DockPanel.Dock="Top">
                <ToolBar>
                    <ToggleButton x:Name="PlaceTool" IsChecked="True" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Place" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MoveTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Move" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="EraseTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌫" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Erase" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FillTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🪣" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Fill" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="SelectTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Select" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MagicWandTool" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" FontSize="12" Margin="2,0" />
                            <TextBlock Text="Wand" Margin="4,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="UndoButton" Margin="8,0,0,0" ToolTip="Undo (Ctrl+Z)">Undo</Button>
                    <Button x:Name="RedoButton" Margin="4,0,0,0" ToolTip="Redo (Ctrl+Y)">Redo</Button>
                    <Separator Margin="8,0" />
                    <CheckBox x:Name="PreviewModeCheckbox" Content="Preview Mode" VerticalAlignment="Center" Margin="4,0" ToolTip="Enable animated previews (saws, etc.)" />
                </ToolBar>
            </ToolBarTray>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
            <Button x:Name="SaveButton" Content="Save" Margin="2" />
            <Button x:Name="LoadButton" Content="Load" Margin="2" />
            <TextBlock Text="Width (X):" VerticalAlignment="Center" Margin="6,0,2,0" />
            <TextBox x:Name="WidthBox" Width="60" Margin="2" />
            <TextBlock Text="Height (Y):" VerticalAlignment="Center" Margin="8,0,2,0" />
            <TextBox x:Name="HeightBox" Width="60" Margin="2" />
            <Button x:Name="ResizeButton" Content="Resize" Margin="2" />
            <TextBlock x:Name="StatusText" Margin="8,2" VerticalAlignment="Center" />
            </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="4">
            <TextBlock Text="Grid darkness:" VerticalAlignment="Center" Margin="4,0"/>
            <Slider x:Name="GridDarknessSlider" Minimum="0" Maximum="1" Value="0.18" Width="200" Focusable="False" />
            <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" Width="200" TickFrequency="1" IsSnapToTickEnabled="True" Focusable="False" />
            <TextBlock x:Name="ZoomLevelLabel" Text="1x" VerticalAlignment="Center" Margin="4,0" Width="24" />
        </StackPanel>

        <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                      IsManipulationEnabled="True">
            <Grid>
                <!-- Background base, Parallax, Ground, Tiles layer, Sprites layer, Grid overlay -->
                <Image x:Name="BackgroundImage" />
                <Image x:Name="ParallaxImage" />
                <Image x:Name="GroundImage" />
                <Image x:Name="TilesImage" />
                <Image x:Name="PortalsImage" />
                <Image x:Name="SpritesImage" />
                <Image x:Name="GridImage" />
                <Canvas x:Name="CanvasHost" Background="Transparent">
                    <!-- Hover rectangle: shown while mouse is over a tile -->
                    <Rectangle x:Name="HoverRect" Fill="#28FFFF00" Stroke="Yellow" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                        <!-- Selection overlay canvas: contains individual rectangle overlays for each selected tile -->
                        <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" />
                        <!-- Ghost image shown while dragging a selection -->
                        <Image x:Name="GhostImage" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.75" />
                </Canvas>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
