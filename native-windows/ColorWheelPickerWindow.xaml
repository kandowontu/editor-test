<Window x:Class="FamidashEditor.ColorWheelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Editor Background Color" Height="400" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Color wheel and brightness slider -->
        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            
            <!-- Color wheel canvas -->
            <Canvas x:Name="ColorWheelCanvas" Width="280" Height="280" Grid.Column="0"
                    MouseLeftButtonDown="ColorWheel_MouseDown"
                    MouseMove="ColorWheel_MouseMove"
                    MouseLeftButtonUp="ColorWheel_MouseUp">
                <Image x:Name="ColorWheelImage" Width="280" Height="280" />
                <!-- Selection indicator -->
                <Ellipse x:Name="SelectionIndicator" Width="12" Height="12" 
                         Stroke="White" StrokeThickness="2" Fill="Transparent"
                         IsHitTestVisible="False" />
            </Canvas>
            
            <!-- Brightness slider on the right -->
            <Border Grid.Column="1" Background="#202020" CornerRadius="4" Padding="2">
                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" 
                        Orientation="Vertical" TickFrequency="10" 
                        VerticalAlignment="Stretch" />
            </Border>
        </Grid>
        
        <!-- Preview and values -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Width="120" Height="60" CornerRadius="4" Margin="0,0,12,0">
                <Border.Background>
                    <DrawingBrush Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#CCCCCC">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,10,10" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#999999">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,5,5" />
                                            <RectangleGeometry Rect="5,5,5,5" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Border x:Name="PreviewBorder" Background="Black" CornerRadius="4" />
            </Border>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="RgbValueText" Text="RGB: 0, 0, 0" Margin="0,2" />
                <TextBlock x:Name="HexValueText" Text="Hex: #000000" Margin="0,2" />
            </StackPanel>
        </Grid>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="4,0" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="4,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
