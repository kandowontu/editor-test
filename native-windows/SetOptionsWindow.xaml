<Window x:Class="FamidashEditor.SetOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set Options" Height="380" Width="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Starting speed will be placed under the left column controls to save space -->

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sprite/Deco Set:" Margin="0,0,0,6" />
            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="DecoCombo" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="DECO1" />
                <ComboBoxItem Content="DECOCLOUD" />
                <ComboBoxItem Content="EXTRASPRITES1" />
            </ComboBox>
            <CheckBox Grid.Row="2" Grid.Column="0" x:Name="LockSpritesCheckBox" Content="Lock sprites to currently usable set" Margin="0,6,0,0" Width="260" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Block Set:" Margin="0,8,0,6" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Starting Background Color:" Margin="8,0,0,6" />

            <ComboBox Grid.Row="4" Grid.Column="0" x:Name="BlockCombo" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="BLOCKSA" />
                <ComboBoxItem Content="BLOCKSB" />
                <ComboBoxItem Content="BLOCKSC" />
                <ComboBoxItem Content="BLOCKSD" />
            </ComboBox>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="StartingBackgroundColorCombo" Width="140" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Top">
                <!-- Allowed values: 0x00-0x0C, 0x0F, 0x10-0x1C, 0x20-0x2C -->
                <ComboBoxItem Content="0x00" />
                <ComboBoxItem Content="0x01" />
                <ComboBoxItem Content="0x02" />
                <ComboBoxItem Content="0x03" />
                <ComboBoxItem Content="0x04" />
                <ComboBoxItem Content="0x05" />
                <ComboBoxItem Content="0x06" />
                <ComboBoxItem Content="0x07" />
                <ComboBoxItem Content="0x08" />
                <ComboBoxItem Content="0x09" />
                <ComboBoxItem Content="0x0A" />
                <ComboBoxItem Content="0x0B" />
                <ComboBoxItem Content="0x0C" />
                <ComboBoxItem Content="0x0F" />
                <ComboBoxItem Content="0x10" />
                <ComboBoxItem Content="0x11" />
                <ComboBoxItem Content="0x12" />
                <ComboBoxItem Content="0x13" />
                <ComboBoxItem Content="0x14" />
                <ComboBoxItem Content="0x15" />
                <ComboBoxItem Content="0x16" />
                <ComboBoxItem Content="0x17" />
                <ComboBoxItem Content="0x18" />
                <ComboBoxItem Content="0x19" />
                <ComboBoxItem Content="0x1A" />
                <ComboBoxItem Content="0x1B" />
                <ComboBoxItem Content="0x1C" />
                <ComboBoxItem Content="0x20" />
                <ComboBoxItem Content="0x21" />
                <ComboBoxItem Content="0x22" />
                <ComboBoxItem Content="0x23" />
                <ComboBoxItem Content="0x24" />
                <ComboBoxItem Content="0x25" />
                <ComboBoxItem Content="0x26" />
                <ComboBoxItem Content="0x27" />
                <ComboBoxItem Content="0x28" />
                <ComboBoxItem Content="0x29" />
                <ComboBoxItem Content="0x2A" />
                <ComboBoxItem Content="0x2B" />
                <ComboBoxItem Content="0x2C" />
            </ComboBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Spike Set:" Margin="0,8,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Starting Ground Color:" Margin="8,0,0,6" />

            <ComboBox Grid.Row="6" Grid.Column="0" x:Name="SpikeCombo" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="SPIKESA" />
                <ComboBoxItem Content="SPIKESB" />
                <ComboBoxItem Content="SPIKESC" />
            </ComboBox>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="StartingGroundColorCombo" Width="140" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Top">
                <!-- Same allowed values as background -->
                <ComboBoxItem Content="0x00" />
                <ComboBoxItem Content="0x01" />
                <ComboBoxItem Content="0x02" />
                <ComboBoxItem Content="0x03" />
                <ComboBoxItem Content="0x04" />
                <ComboBoxItem Content="0x05" />
                <ComboBoxItem Content="0x06" />
                <ComboBoxItem Content="0x07" />
                <ComboBoxItem Content="0x08" />
                <ComboBoxItem Content="0x09" />
                <ComboBoxItem Content="0x0A" />
                <ComboBoxItem Content="0x0B" />
                <ComboBoxItem Content="0x0C" />
                <ComboBoxItem Content="0x0F" />
                <ComboBoxItem Content="0x10" />
                <ComboBoxItem Content="0x11" />
                <ComboBoxItem Content="0x12" />
                <ComboBoxItem Content="0x13" />
                <ComboBoxItem Content="0x14" />
                <ComboBoxItem Content="0x15" />
                <ComboBoxItem Content="0x16" />
                <ComboBoxItem Content="0x17" />
                <ComboBoxItem Content="0x18" />
                <ComboBoxItem Content="0x19" />
                <ComboBoxItem Content="0x1A" />
                <ComboBoxItem Content="0x1B" />
                <ComboBoxItem Content="0x1C" />
                <ComboBoxItem Content="0x20" />
                <ComboBoxItem Content="0x21" />
                <ComboBoxItem Content="0x22" />
                <ComboBoxItem Content="0x23" />
                <ComboBoxItem Content="0x24" />
                <ComboBoxItem Content="0x25" />
                <ComboBoxItem Content="0x26" />
                <ComboBoxItem Content="0x27" />
                <ComboBoxItem Content="0x28" />
                <ComboBoxItem Content="0x29" />
                <ComboBoxItem Content="0x2A" />
                <ComboBoxItem Content="0x2B" />
                <ComboBoxItem Content="0x2C" />
            </ComboBox>

            <!-- Starting game mode (placed under Starting Ground Color) -->
            <TextBlock Grid.Row="4" Grid.Column="1" Text="Starting Game Mode:" Margin="8,0,0,6" />
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="StartingGameModeCombo" Width="140" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Top">
                <ComboBoxItem Content="Cube (default)" Tag="0" />
                <ComboBoxItem Content="Ship" Tag="1" />
                <ComboBoxItem Content="Ball" Tag="2" />
                <ComboBoxItem Content="UFO" Tag="3" />
                <ComboBoxItem Content="Robot" Tag="4" />
                <ComboBoxItem Content="Spider" Tag="5" />
                <ComboBoxItem Content="Wave" Tag="6" />
                <ComboBoxItem Content="Swing" Tag="7" />
                <ComboBoxItem Content="Ninja" Tag="8" />
            </ComboBox>

            <!-- Move Show accurate tileset under spike set -->
            <CheckBox Grid.Row="7" Grid.Column="0" x:Name="ShowAccurateTilesetCheckBox" Content="Show accurate tileset" Margin="0,8,0,0" Width="320" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- Starting speed moved up to align with other starting options -->
            <TextBlock Grid.Row="6" Grid.Column="1" Text="Starting Speed:" Margin="8,0,0,6" />
            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="StartingSpeedCombo" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0">
                <ComboBoxItem Content="0.5x" />
                <ComboBoxItem Content="1x" />
                <ComboBoxItem Content="2x" />
                <ComboBoxItem Content="3x" />
                <ComboBoxItem Content="4x" />
            </ComboBox>

            <!-- Difficulty and Stars (per-level) -->
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Difficulty:" Margin="8,8,0,6" />
            <ComboBox Grid.Row="9" Grid.Column="1" x:Name="DifficultyCombo" Width="140" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Top">
                <ComboBoxItem Content="Auto" Tag="6" />
                <ComboBoxItem Content="Easy" Tag="0" />
                <ComboBoxItem Content="Normal" Tag="1" />
                <ComboBoxItem Content="Hard" Tag="2" />
                <ComboBoxItem Content="Harder" Tag="3" />
                <ComboBoxItem Content="Insane" Tag="4" />
                <ComboBoxItem Content="Demon" Tag="5" />
            </ComboBox>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Stars:" Margin="0,8,0,6" />
            <ComboBox Grid.Row="9" Grid.Column="0" x:Name="StarsCombo" Width="120" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top">
                <ComboBoxItem Content="1*" Tag="1" />
                <ComboBoxItem Content="2*" Tag="2" />
                <ComboBoxItem Content="3*" Tag="3" />
                <ComboBoxItem Content="4*" Tag="4" />
                <ComboBoxItem Content="5*" Tag="5" />
                <ComboBoxItem Content="6*" Tag="6" />
                <ComboBoxItem Content="7*" Tag="7" />
                <ComboBoxItem Content="8*" Tag="8" />
                <ComboBoxItem Content="9*" Tag="9" />
                <ComboBoxItem Content="10*" Tag="10" />
            </ComboBox>

            <!-- Upper / Lower Text (per-level) -->
            <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,8,0,0">
                <TextBlock Text="Upper Text:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="UpperTextBox" Width="150" CharacterCasing="Upper" MaxLength="15" IsEnabled="False" />
            </StackPanel>
            <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,8,0,0">
                <TextBlock Text="Lower Text:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="LowerTextBox" Width="150" CharacterCasing="Upper" MaxLength="15" />
            </StackPanel>

            <!-- OK/Cancel buttons moved up slightly -->
            <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                <Button x:Name="OkButton" Width="75" Margin="4,0">K</Button>
                <Button x:Name="CancelButton" Width="75" Margin="4,0">Cancel</Button>
            </StackPanel>
        </Grid>

        <!-- Right side: vertical quick-buttons for tints -->
        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock Text="Quick Tints" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center" />
            <Button x:Name="BgTintButton" Content="Background Tint..." Width="120" Margin="0,4" />
            <Button x:Name="GroundTintButton" Content="Ground Tint..." Width="120" Margin="0,4" />
            <Button x:Name="TileTintButton" Content="Tile Tint..." Width="120" Margin="0,4" />
            <CheckBox x:Name="NoParallaxCheckBox" Content="No Parallax BG" Margin="0,10,0,0" Width="120" HorizontalAlignment="Center" />
            <Button x:Name="AttemptJsonLoadButton" Content="Attempt JSON Load" Width="120" Margin="0,10,0,0" />
            <Button x:Name="RemoveSpriteShiftsButton" Content="Remove Sprite Shifts" Width="120" Margin="0,4,0,0" />
            <Button x:Name="ExportShiftJsonButton" Content="Export JSON" Width="120" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>