<Window x:Class="FamidashEditor.SetOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Set Options" Height="240" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Deco Set:" Margin="0,0,0,6" />
            <ComboBox x:Name="DecoCombo" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Content="DECO1" />
                <ComboBoxItem Content="DECOCLOUD" />
                <ComboBoxItem Content="EXTRASPRITES1" />
            </ComboBox>
            <TextBlock Text="Block Set:" Margin="0,8,0,6" />
            <ComboBox x:Name="BlockCombo" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Content="BLOCKSA" />
                <ComboBoxItem Content="BLOCKSB" />
                <ComboBoxItem Content="BLOCKSC" />
                <ComboBoxItem Content="BLOCKSD" />
            </ComboBox>
            <TextBlock Text="Spike Set:" Margin="0,8,0,6" />
            <ComboBox x:Name="SpikeCombo" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Content="SPIKESA" />
                <ComboBoxItem Content="SPIKESB" />
                <ComboBoxItem Content="SPIKESC" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Width="75" Margin="4,0">OK</Button>
                <Button x:Name="CancelButton" Width="75" Margin="4,0">Cancel</Button>
            </StackPanel>
        </StackPanel>

        <!-- Right side: vertical quick-buttons for tints -->
        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock Text="Quick Tints" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center" />
            <Button x:Name="BgTintButton" Content="Background Tint..." Width="120" Margin="0,4" />
            <Button x:Name="GroundTintButton" Content="Ground Tint..." Width="120" Margin="0,4" />
            <Button x:Name="TileTintButton" Content="Tile Tint..." Width="120" Margin="0,4" />
            <CheckBox x:Name="NoParallaxCheckBox" Content="No Parallax BG" Margin="0,10,0,0" Width="120" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>