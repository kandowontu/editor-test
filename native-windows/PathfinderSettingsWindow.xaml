<Window x:Class="FamidashEditor.PathfinderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pathfinder Settings" Width="420" Height="465"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF2D2D30" Foreground="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Jump / Input Timing" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,4">
            <RadioButton x:Name="OptEarliest" Content="Earliest possible" Foreground="White" Margin="0,3" FontSize="12"/>
            <RadioButton x:Name="OptEarly" Content="Early" Foreground="White" Margin="0,3" FontSize="12"/>
            <RadioButton x:Name="OptMiddle" Content="Middle (default)" Foreground="White" Margin="0,3" FontSize="12" IsChecked="True"/>
            <RadioButton x:Name="OptLate" Content="Late" Foreground="White" Margin="0,3" FontSize="12"/>
            <RadioButton x:Name="OptLatest" Content="Latest possible" Foreground="White" Margin="0,3" FontSize="12"/>
        </StackPanel>

		<TextBlock Grid.Row="2" x:Name="BiasLabel" Text="Use neutral timing across every game mode"
				   FontSize="11" Foreground="#999999" HorizontalAlignment="Left" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,8,0,0">
            <CheckBox x:Name="ChkFastSearch" Content="Fast exact search first" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="True"
                      ToolTip="Try a bounded exact-state beam first. If it cannot prove a complete replay quickly, exhaustive BFS starts automatically."/>
            <CheckBox x:Name="ChkPreferCoins" Content="Prefer coins" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="True"
                      ToolTip="Try to collect coins (0x07, 0x1A, 0x1B) along the path"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,8,0,0">
            <CheckBox x:Name="ChkDrawPathLine" Content="Draw path line when complete" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="True" ToolTip="Draw the pathfinder path line on the map when calculation finishes. Uncheck for faster completion on long levels."/>
            <CheckBox x:Name="ChkShowLive" Content="Show pathfinder live" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="True" ToolTip="Show speculative paths in real-time while calculating"/>
            <CheckBox x:Name="ChkShowProspective" Content="Show prospective paths after" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="False" ToolTip="Show all attempted/backtracked paths after calculation completes"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,10,0,0">
            <TextBlock Text="Diagnostic logging" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
            <CheckBox x:Name="ChkPathfinderLogging" Content="Pathfinder logs (%TEMP%)" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="True" ToolTip="Write Pathfinder frame, physics, and interaction diagnostic logs while calculating."/>
            <CheckBox x:Name="ChkMesenLogging" Content="Mesen replay logs (%TEMP%)" Foreground="White" FontSize="12" Margin="0,3"
                      IsChecked="True" ToolTip="Allow generated replay Lua scripts to write Mesen trace, physics, and interaction diagnostic logs."/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Calculate Path" Padding="16,6" Click="OkButton_Click" IsDefault="True"
                    Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Padding="16,6" Margin="8,0,0,0" Click="CancelButton_Click" IsCancel="True"
                    Background="#FF3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
