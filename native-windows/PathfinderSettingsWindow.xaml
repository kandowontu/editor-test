<Window x:Class="FamidashEditor.PathfinderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pathfinder Settings" Width="420" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF2D2D30" Foreground="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Jump Timing" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,4">
            <RadioButton x:Name="OptEarliest" Content="Earliest possible" Foreground="White" Margin="0,3" FontSize="12"/>
            <RadioButton x:Name="OptEarly" Content="Early" Foreground="White" Margin="0,3" FontSize="12"/>
            <RadioButton x:Name="OptMiddle" Content="Middle (default)" Foreground="White" Margin="0,3" FontSize="12" IsChecked="True"/>
            <RadioButton x:Name="OptLate" Content="Late" Foreground="White" Margin="0,3" FontSize="12"/>
            <RadioButton x:Name="OptLatest" Content="Latest possible" Foreground="White" Margin="0,3" FontSize="12"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="BiasLabel" Text="Jump at the midpoint between earliest and latest viable timing" 
                   FontSize="11" Foreground="#999999" HorizontalAlignment="Left" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Calculate Path" Padding="16,6" Click="OkButton_Click" IsDefault="True"
                    Background="#FF007ACC" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Padding="16,6" Margin="8,0,0,0" Click="CancelButton_Click" IsCancel="True"
                    Background="#FF3E3E42" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
