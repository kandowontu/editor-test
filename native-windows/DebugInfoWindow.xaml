<Window x:Class="FamidashEditor.DebugInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug Info" Height="450" Width="220" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Topmost="True">
    <Border Background="#DD000000" BorderBrush="#FFAA00" BorderThickness="2" Padding="8">
        <StackPanel>
            <TextBlock Text="Debug Info (SHIFT-F11)" Foreground="#FFAA00" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
            <TextBlock x:Name="DbgGameModeText" Text="Game mode: 0" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgMiniText" Text="Mini: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgInvertedGravityText" Text="Inverted gravity: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgXPosText" Text="X position: 0" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgYPosText" Text="Y position: 0" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgXSpeedText" Text="X speed: 1x" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgNinjaJumpsText" Text="Ninja jumps: 3" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgDBlockedText" Text="D blocked: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgHBlockedText" Text="H blocked: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgFBlockedText" Text="F blocked: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgJBlockedText" Text="J blocked: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgOrbedText" Text="Orbed: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgBlackOrbedText" Text="Black orbed: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgDashingText" Text="Dashing: 0" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgRobotJumpTimeText" Text="Robot jump time: 0" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgPlayerYVelText" Text="Player Y vel: 0" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgBufferActiveText" Text="Buffer active: False" Foreground="White" FontSize="11" Margin="0,2"/>
            <TextBlock x:Name="DbgFreeCamText" Text="FreeCam: False" Foreground="White" FontSize="11" Margin="0,2"/>
        </StackPanel>
    </Border>
</Window>
