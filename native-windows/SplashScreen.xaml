<Window x:Class="FamidashEditor.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Famidash Editor"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="2" CornerRadius="8">
        <Image x:Name="SplashImage" Stretch="None" Margin="10" />
    </Border>
</Window>
