<Window x:Class="FamidashEditor.MusicLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Music Library" Height="430" Width="700"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Custom music for the editor and Mesen build" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#555555"
                       Text="Choose a FamiStudio album. The editor will copy it into your local music library, export the song list, generate the JSON index files, and use that album for future local Mesen builds." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Album (.fms):" VerticalAlignment="Center" />
            <TextBox x:Name="AlbumPathBox" Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center" />
            <Button x:Name="BrowseAlbumButton" Grid.Column="2" Content="Browse..." Padding="8,4" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Audio previews:" VerticalAlignment="Center" />
            <TextBox x:Name="PreviewFolderBox" Grid.Column="1" Margin="0,0,8,0" VerticalContentAlignment="Center"
                     ToolTip="Optional folder containing MP3/WAV/OGG files named after songs or prefixed with their track number." />
            <Button x:Name="BrowsePreviewButton" Grid.Column="2" Content="Browse..." Padding="8,4" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="125,0,0,12">
            <TextBlock Text="Optional: existing MP3/WAV/OGG files are matched by song name or track number and copied into the library." TextWrapping="Wrap" Foreground="#666666" FontSize="12" />
            <CheckBox x:Name="RenderPreviewsCheckBox" Margin="0,10,0,0"
                      Content="Pre-render every missing song to MP3 now (may take a long time for large albums)" />
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="1" Background="#F7F7F7" Padding="12" Margin="0,2,0,14">
            <StackPanel>
                <TextBlock Text="What gets generated" FontWeight="SemiBold" Margin="0,0,0,5" />
                <TextBlock TextWrapping="Wrap" Foreground="#555555"
                           Text="album.fms, a FamiStudio text export, fami-album-parsed.json, fami-song-index-map.json, and an optional playback-map.json. Missing previews are rendered and cached on demand when you press Play, even if you do not pre-render them here." />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#7A4C00"
                           Text="MP3 files are playback previews only. The NES build uses the selected .fms project; recorded MP3 audio cannot be converted automatically into NES/FamiStudio arrangements." />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" LastChildFill="False">
            <Button x:Name="UseBundledButton" DockPanel.Dock="Left" Content="Use Bundled Album" Padding="12,5" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Width="86" Padding="8,5" Margin="8,0,0,0" IsCancel="True" />
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="Install and Use" Width="116" Padding="8,5" IsDefault="True" />
        </DockPanel>
    </Grid>
</Window>
