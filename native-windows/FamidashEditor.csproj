<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Exclude unnecessary satellite assemblies to reduce size -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF doesn't work well with single-file, keep multi-file -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Add application manifest for DPI awareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Include app config for DLL probing -->
    <None Include="FamidashEditor.exe.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    
    <!-- Embed assets as resources -->
    <EmbeddedResource Include="..\saw-frame1.png" />
