<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Prevent duplicate assembly attributes when the project also defines them manually -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Pathfinder BFS is allocation-heavy and already parallel. Server GC
         lets its independent heaps collect concurrently without changing any
         simulation or path-selection behavior. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Disable ReadyToRun for faster publish times - single-file exe is already optimized -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Exclude unnecessary satellite assemblies to reduce size -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Enable single-file publishing for Release builds (reduces file count) -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF doesn't work well with trimming - keep disabled -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Add application manifest for DPI awareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Set application icon from cube.png -->
    <ApplicationIcon>cube.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Pathfinder diagnostic output is runtime-selectable in the settings dialog.
         NoDebugLogging remains available as an opt-in compile-time stripped build. -->
  </PropertyGroup>

  <!-- NoDebugLogging: suppress ALL sim debug logging (file I/O + string allocs) -->
  <PropertyGroup Condition="'$(Configuration)' == 'NoDebugLogging'">
    <DefineConstants>$(DefineConstants);DISABLE_DEBUG_LOGGING</DefineConstants>
  </PropertyGroup>

