<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Package everything into a single .exe file -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Disable ReadyToRun for faster publish - use false for quicker builds -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Enable trimming to remove unused code -->
    <!-- Note: Be careful - only enable if reflection-heavy code is minimal -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Compress assemblies in single file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Use smaller debug info -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
