{
  "name": "famidash-editor",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
  "dev": "node scripts/copy-assets.js && concurrently \"vite\" \"tsc -w -p tsconfig.main.json\" \"node scripts/start-electron-after-build.js\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main && electron-builder",
    "start": "electron .",
    "lint": "echo \"no lint configured\"",
    "test": "echo \"no tests configured\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "concurrently": "^8.2.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "typescript": "^5.5.0",
    "vite": "^5.1.0",
    "@vitejs/plugin-react": "^4.0.0",
    "wait-on": "^7.0.1"
  }
}
