<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);DISABLE_DEBUG_LOGGING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Link to the real source files so changes propagate automatically -->
    <Compile Include="..\native-windows\PathfinderEngine.cs" Link="PathfinderEngine.cs" />
    <Compile Include="..\native-windows\NesSpriteData.cs" Link="NesSpriteData.cs" />
    <Compile Include="..\native-windows\SharedPhysics.cs" Link="SharedPhysics.cs" />
    <Compile Include="..\native-windows\TmxHandler.cs" Link="TmxHandler.cs" />
    <Compile Include="..\native-windows\MetatileCollision.cs" Link="MetatileCollision.cs" />
    <Compile Include="..\native-windows\PfTrace.cs" Link="PfTrace.cs" />
  </ItemGroup>
</Project>
